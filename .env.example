# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Web app auth — pick ONE of the two modes ────────────────────────────
# RECOMMENDED: Supabase (real per-user accounts for you + your brother).
# supabase.com → New project → Settings → API:
#   SUPABASE_URL        = Project URL
#   SUPABASE_ANON_KEY   = anon/public key
#   SUPABASE_JWT_SECRET = Settings → API → JWT Settings → JWT Secret
# ALLOWED_EMAILS restricts who can use the deployment — SET IT.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
ALLOWED_EMAILS=you@example.com,brother@example.com

# OR: simple mode — one shared family password (used only when the Supabase
# vars above are empty). Empty disables auth entirely (local dev only).
APP_PASSWORD=

# Set to 1 to run the watchers/scheduler inside the web app process
# (the Dockerfile sets this; leave unset when running scheduler.py separately)
SCHEDULER_IN_APP=0

# News sources (NewsAPI optional; RSS + watch layer work with no key)
NEWS_API_KEY=
GNEWS_API_KEY=

# Storage
DB_PATH=agent.db

# Polling intervals (minutes) — optional overrides
POLL_NEWS_MIN=15
POLL_YOUTUBE_MIN=15
POLL_REDDIT_MIN=20
POLL_TRENDS_MIN=30
POLL_WIKIPEDIA_MIN=60
POLL_PROCESS_MIN=10
STALE_AFTER_MIN=180
PROCESS_BATCH=40

# Reddit OAuth — lifts the 403 that Railway datacenter IPs get from Reddit.
# Setup (5 min): reddit.com/prefs/apps → Create App → type: script
# client_id is the string directly below the app name (not the secret).
# Without these vars the watcher falls back to keyless (works locally, fails on Railway).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# Transcription backend — controls how YouTube/audio is transcribed.
# youtube_captions (default): free, keyless, YouTube only.
# assemblyai: 100 hrs/month FREE forever — best for Indian English + Hinglish.
#   Sign up at assemblyai.com, copy the API key below.
# openai: OpenAI Whisper API ($0.006/min, large-v3 quality). Needs key below.
# local: faster-whisper on-device. Zero cost. Needs ≥1GB free RAM + ffmpeg.
#   Run: pip install faster-whisper yt-dlp  (already commented in requirements.txt)
#   WHISPER_MODEL: tiny (39MB, fast, poor accents) | base | small (best balance) | medium
TRANSCRIPTION_BACKEND=youtube_captions
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
WHISPER_MODEL=small

# Crowd wisdom / Genome B (optional — twitterapi.io key; without it the crowd
# layer no-ops and everything else still works)
TWITTER_API_IO_KEY=
CROWD_MIN_LIKES=1000
CROWD_TOP_K=50
POLL_CROWD_MIN=10080

# Approve/reject learning loop
LEARN_MIN_REVIEWED=10
LEARN_MIN_SIDE=3
LEARN_PRIOR_WEIGHT=10
POLL_LEARN_MIN=360

# Copilot dispatch — manual posting flow (no X API; you post yourself).
# Bot token from @BotFather. Chat id: message your bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a Telegram CHANNEL the bot auto-publishes approved posts to
# (@channelname or -100… id). Safe — Telegram supports bot posting natively.
TELEGRAM_CHANNEL_ID=
POLL_TELEGRAM_MIN=1
# Rule #10 label appended to postable text. Leave empty (AI_LABEL=) to disable
# since a human reviews and posts every item.
AI_LABEL=🤖 AI-assisted

# Image cards (branded PNG attached to the Telegram approval package).
# CARDS_ENABLED=0 to turn off. Uncomment CARDS_DIR to move them off ./cards
CARDS_ENABLED=1
# CARDS_DIR=/path/to/cards

# Callback generator (open predictions vs incoming news)
POLL_CALLBACKS_MIN=60
CALLBACK_MIN_KEYWORD_HITS=2
CALLBACK_MAX_CANDIDATES=3
CALLBACK_EXPIRE_DAYS=180

# Audience fatigue: more than N audience-facing posts on one topic in the
# window -> stop drafting that topic
FATIGUE_WINDOW_HOURS=72
FATIGUE_MAX_POSTS=3

# Timing engine + briefing (storage is UTC; advice shown in your timezone)
TZ_OFFSET_MIN=330
TZ_LABEL=IST
TIMING_MIN_SAMPLES=8
BRIEFING_HOUR=8

# Counter-narrative detector
POLL_COUNTER_MIN=120
COUNTER_MIN_COVERAGE=3

# Voice corpus
CORPUS_MAX_OWN=300
CORPUS_MAX_INSPIRATION=10
CORPUS_SUGGEST_MAX=5

# Cost guard: hard daily Claude budget (USD); 0 disables the cap.
# Every call is logged to claude_logs regardless.
DAILY_BUDGET_USD=5.0
COST_IN_PER_MTOK=3.0
COST_OUT_PER_MTOK=15.0

# Grounding shield: flags draft claims unsupported by the source material
GROUNDING_ENABLED=1

# Warn when a draft has waited this long (the moment may have passed)
DRAFT_STALE_HOURS=24

# Daily DB backups (VACUUM INTO), oldest pruned past the cap
BACKUP_KEEP=7
# BACKUPS_DIR=/path/to/backups

# Stance arc guard — flag drafts that reverse your past positions
ARC_GUARD_ENABLED=1
# Backlash simulator — red-team high-stakes (FIRE) drafts
RISK_CHECK_ENABLED=1

# Concurrency / resilience
DB_BUSY_TIMEOUT_S=30          # queue colliding SQLite writes (vs "database is locked")
FEED_FETCH_WORKERS=12         # parallel RSS fetch fan-out
CORPUS_SOURCE_CAP_FRACTION=0.5  # max share of one outlet in the inspiration set

# Content Squeezer (repurpose one input into a multi-format pack)
REPURPOSE_MAX_CHARS=12000

# Visuals (Satori render service — see VISUALS.md)
VISUALS_ENABLED=1
VISUALS_PORT=8787
# VISUALS_DIR=/path/to/visuals
# Decoration layer on cards (topic icon + geometric motif at low opacity).
# subtle (default) keeps cards editorial; bold turns it up; none disables.
VISUALS_DECOR=subtle

# Carousel (square slides for LinkedIn/IG)
CAROUSEL_MAX_SLIDES=6
CAROUSEL_SLIDE_CHARS=300
